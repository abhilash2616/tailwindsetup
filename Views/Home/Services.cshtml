@{
    ViewBag.Title = "Services";
}

<section class="min-h-screen bg-gray-950 px-6 py-20 text-white">
    <div class="mx-auto max-w-7xl">

        <h1 class="text-4xl font-bold">
            Our Services
        </h1>

        <p class="mt-6 text-gray-400">
            Explore the services we provide.
        </p>

        <div class="mt-10 grid gap-6 md:grid-cols-3">

            <div class="rounded-xl border border-white/10 bg-gray-900 p-6">
                <h2 class="text-xl font-semibold">Web Development</h2>
                <p class="mt-3 text-gray-400">
                    Modern and responsive websites.
                </p>
            </div>

            <div class="rounded-xl border border-white/10 bg-gray-900 p-6">
                <h2 class="text-xl font-semibold">UI Design</h2>
                <p class="mt-3 text-gray-400">
                    Clean and user-friendly interfaces.
                </p>
            </div>

            <div class="rounded-xl border border-white/10 bg-gray-900 p-6">
                <h2 class="text-xl font-semibold">Consulting</h2>
                <p class="mt-3 text-gray-400">
                    Technical guidance for your projects.
                </p>
            </div>

        </div>

    </div>
</section>